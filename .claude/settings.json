{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/scripts/git-guardrails.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/scripts/commit-style.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/scripts/stack-guardrails.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/scripts/stack-guardrails.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/scripts/stack-guardrails.sh"
          }
        ]
      }
    ]
  }
}
